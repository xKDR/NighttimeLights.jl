@article{
doi:10.1126/sciadv.1701528,
author = {Christopher C. M. Kyba  and Theres Kuester  and Alejandro Sánchez de Miguel  and Kimberly Baugh  and Andreas Jechow  and Franz Hölker  and Jonathan Bennie  and Christopher D. Elvidge  and Kevin J. Gaston  and Luis Guanter },
title = {Artificially lit surface of Earth at night increasing in radiance and extent},
journal = {Science Advances},
volume = {3},
number = {11},
pages = {e1701528},
year = {2017},
doi = {10.1126/sciadv.1701528},
URL = {https://www.science.org/doi/abs/10.1126/sciadv.1701528},
eprint = {https://www.science.org/doi/pdf/10.1126/sciadv.1701528},
abstract = {Earth’s artificially lit area is expanding at 2.2\% per year, with existing lit areas brightening by 2.2\% per year. A central aim of the “lighting revolution” (the transition to solid-state lighting technology) is decreased energy consumption. This could be undermined by a rebound effect of increased use in response to lowered cost of light. We use the first-ever calibrated satellite radiometer designed for night lights to show that from 2012 to 2016, Earth’s artificially lit outdoor area grew by 2.2\% per year, with a total radiance growth of 1.8\% per year. Continuously lit areas brightened at a rate of 2.2\% per year. Large differences in national growth rates were observed, with lighting remaining stable or decreasing in only a few countries. These data are not consistent with global scale energy reductions but rather indicate increased light pollution, with corresponding negative consequences for flora, fauna, and human well-being.}}

@Article{rs12182950,
AUTHOR = {Ivan, Kinga and Holobâcă, Iulian-Horia and Benedek, József and Török, Ibolya},
TITLE = {VIIRS Nighttime Light Data for Income Estimation at Local Level},
JOURNAL = {Remote Sensing},
VOLUME = {12},
YEAR = {2020},
NUMBER = {18},
ARTICLE-NUMBER = {2950},
URL = {https://www.mdpi.com/2072-4292/12/18/2950},
ISSN = {2072-4292},
ABSTRACT = {The aim of the paper is to develop a model for the real-time estimation of local level income data by combining machine learning, Earth Observation, and Geographic Information System. More exactly, we estimated the income per capita by help of a machine learning model for 46 cities with more than 50,000 inhabitants, based on the National Polar-orbiting Partnership&ndash;Visible Infrared Imaging Radiometer Suite (NPP-VIIRS) nighttime satellite images from 2012&ndash;2018. For the automation of calculation, a new ModelBuilder type tool was developed within the ArcGIS software called EO-Incity (Earth Observation&ndash;Income city). The sum of light (SOL) data extracted by means of the EO-Incity tool and the observed income data were integrated in an algorithm within the MATLAB software in order to calculate a transfer equation and the average error. The results achieved were subsequently reintegrated in EO-Incity and used for the estimation of the income value at local level. The regression analyses highlighted a stable and strong relationship between SOL and income for the analyzed cities. The EO-Incity tool and the machine learning model proved to be efficient in the real-time estimation of the income at local level. When integrated in the information systems specific for smart cities, they can serve as a support for decision-making in order to fight poverty and reduce social inequalities.},
DOI = {10.3390/rs12182950}
}

